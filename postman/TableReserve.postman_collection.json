    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('authToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": JSON.stringify({
                "email": "customer@tablereserve.com",
                "password": "Customer@123"
              }, null, 2)
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Manager Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('managerToken', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": JSON.stringify({
                "email": "manager@tablereserve.com",
                "password": "Manager@123"
              }, null, 2)
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Register New Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": JSON.stringify({
                "name": "Sophia Reynolds",
                "email": "sophia.reynolds@example.com",
                "password": "Password@123",
                "role": "customer"
              }, null, 2)
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Restaurants",
      "item": [
        {
          "name": "Get All Restaurants",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('restaurantId', res.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants"]
            }
          }
        },
        {
          "name": "Filter Restaurants by Cuisine & Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants?cuisine=French Contemporary&priceLevel=$$$$",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants"],
              "query": [
                { "key": "cuisine", "value": "French Contemporary" },
                { "key": "priceLevel", "value": "$$$$" }
              ]
            }
          }
        },
        {
          "name": "Get Restaurant by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/{{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "{{restaurantId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Tables & Availability",
      "item": [
        {
          "name": "Get Restaurant Tables",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('tableId', res.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/{{restaurantId}}/tables",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "{{restaurantId}}", "tables"]
            }
          }
        },
        {
          "name": "Check Slot Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/restaurants/{{restaurantId}}/availability?date=2026-11-01&time=19:00&partySize=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "restaurants", "{{restaurantId}}", "availability"],
              "query": [
                { "key": "date", "value": "2026-11-01" },
                { "key": "time", "value": "19:00" },
                { "key": "partySize", "value": "2" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Reservations",
      "item": [
        {
          "name": "Create Reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "    pm.collectionVariables.set('reservationId', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": JSON.stringify({
                "restaurantId": "{{restaurantId}}",
                "tableId": "{{tableId}}",
                "date": "2026-11-01",
                "startTime": "19:00",
                "partySize": 2,
                "specialRequests": "Quiet romantic window table"
              }, null, 2)
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"]
            }
          }
        },
        {
          "name": "Test Conflict Rejection (Expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": JSON.stringify({
                "restaurantId": "{{restaurantId}}",
                "tableId": "{{tableId}}",
                "date": "2026-11-01",
                "startTime": "19:30",
                "partySize": 2,
                "specialRequests": "Conflicting reservation attempt"
              }, null, 2)
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations"]
            }
          }
        },
        {
          "name": "Get My Reservations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "my"]
            }
          }
        },
        {
          "name": "Cancel Reservation",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "{{reservationId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Manager Portal",
      "item": [
        {
          "name": "Manager Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/manager/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "manager", "dashboard"]
            }
          }
        },
        {
          "name": "Manager Aggregation Reports",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/manager/reports",
              "host": ["{{baseUrl}}"],
              "path": ["api", "manager", "reports"]
            }
          }
        },
        {
          "name": "Manager Reservation List & Filter",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/manager/reservations?status=confirmed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "manager", "reservations"],
              "query": [{ "key": "status", "value": "confirmed" }]
            }
          }
        },
        {
          "name": "Manager Update Reservation Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": JSON.stringify({ "status": "seated" }, null, 2)
            },
            "url": {
              "raw": "{{baseUrl}}/api/manager/reservations/{{reservationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "manager", "reservations", "{{reservationId}}", "status"]
            }
          }
        }
      ]
    }
  ]
}

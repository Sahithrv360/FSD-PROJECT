    "name": "TableReserve API Collection - Experiment 10",
    "description": "Comprehensive REST API test collection for TableReserve restaurant reservation and management system.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
